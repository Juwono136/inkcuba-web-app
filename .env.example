NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# DATABASE CONFIG
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/inkcuba_db"

# Better-Auth Config
# Login Google via Firebase Authentication (client SDK + Admin verify on server).
# Pre-register users: npm run db:seed-admin -- --email=... --password=... --name=... --role=SUPER_ADMIN
BETTER_AUTH_SECRET="your_better_auth_secret"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_LOCKOUT_ENABLED="true"

# Firebase Config (Google Sign-In via Firebase Authentication)
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="inkcuba-auth"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"

FIREBASE_PROJECT_ID="inkcuba-auth"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email@gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"

# Nodemailer — Gmail SMTP (use App Password with 2FA, not your login password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="official.inkcuba@gmail.com"
SMTP_PASS="your_16_char_gmail_app_password"

# REDIS CONFIG
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your_redis_password"

# STORAGE CONFIG
# nginx-basic = SeaweedFS filer via nginx (USERNAME/PASSWORD = nginx basic auth)
# s3          = SeaweedFS S3 API direct (USERNAME/PASSWORD = S3 access key + secret key)
# Files are stored at /{STORAGE_BUCKET} on the filer root (default: /montera-group).
# The bucket is provisioned once at application startup — health checks verify only.
STORAGE_AUTH_MODE="nginx-basic"
STORAGE_ENDPOINT="http://localhost:8333"
STORAGE_BUCKET="inkcuba"
STORAGE_REGION="us-east-1"
USERNAME_STORAGE="admin"
PASSWORD_STORAGE="your_storage_password"

# Logging (optional: debug | info | warn | error)
LOG_LEVEL="debug"

# Health Check — required for detailed /api/health diagnostics (all environments)
# If the token contains $, escape it as \$ (Next.js expands $VAR in .env values).
HEALTH_CHECK_TOKEN="your_secure_health_check_token_min_16_chars"