NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# DATABASE CONFIG
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/inkcuba_db"

# Better-Auth Config
# Pre-register admin: npm run db:seed-admin -- --email=admin@binus.ac.id --password=... --name=... --role=SUPER_ADMIN
BETTER_AUTH_SECRET="your_better_auth_secret_min_32_characters_long"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_LOCKOUT_ENABLED="true"

# Nodemailer — Gmail SMTP (use App Password with 2FA, not your login password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="official.inkcuba@gmail.com"
SMTP_PASS="your_16_char_gmail_app_password"

# REDIS CONFIG
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your_redis_password"

# STORAGE CONFIG
STORAGE_AUTH_MODE="nginx-basic"
STORAGE_ENDPOINT="http://localhost:8333"
STORAGE_BUCKET="inkcuba"
STORAGE_REGION="us-east-1"
USERNAME_STORAGE="admin"
PASSWORD_STORAGE="your_storage_password"

# Logging (optional: debug | info | warn | error)
LOG_LEVEL="debug"

# Health Check — required for detailed /api/health diagnostics (all environments)
# If the token contains $, escape it as \$ (Next.js expands $VAR in .env values).
HEALTH_CHECK_TOKEN="your_secure_health_check_token_min_16_chars"
